  ENV.delete("BRANCH_NAME")
  ENV.delete("ghprbPullId")
  ENV.delete("SEMAPHORE")
  ENV.delete("SEMAPHORE_WORKFLOW_ID")
  ENV.delete("SEMAPHORE_GIT_WORKING_BRANCH")
